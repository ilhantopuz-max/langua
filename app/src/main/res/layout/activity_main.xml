<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="CORVIS TRANSLATE" android:textColor="#B026FF" android:textSize="26sp"
        android:textStyle="bold" android:letterSpacing="0.08" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Çoklu dil · Sesli karşılıklı çeviri" android:textColor="#39FF14"
        android:textSize="13sp" android:layout_marginBottom="14dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Spinner android:id="@+id/spA" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/card" android:popupBackground="#14141C" />
        <Button android:id="@+id/btnSwap" android:layout_width="56dp" android:layout_height="wrap_content"
            android:text="⇄" android:textSize="18sp" android:backgroundTint="#FF8A00"
            android:textColor="#000000" android:contentDescription="Dilleri değiştir"
            android:layout_marginHorizontal="6dp" android:insetLeft="0dp" android:insetRight="0dp"
            android:paddingHorizontal="0dp" />
        <Spinner android:id="@+id/spB" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/card" android:popupBackground="#14141C" />
    </LinearLayout>

    <EditText android:id="@+id/etInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:minLines="4" android:gravity="top"
        android:hint="Yazın veya mikrofona basıp konuşun…" android:textColorHint="#777777"
        android:textColor="#FFFFFF" android:background="@drawable/card" android:padding="14dp"
        android:inputType="textMultiLine|textCapSentences" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="10dp">
        <Button android:id="@+id/btnMicA" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🎤 Sol dil" android:backgroundTint="#39FF14"
            android:textColor="#000000" android:layout_marginEnd="5dp" />
        <Button android:id="@+id/btnMicB" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🎤 Sağ dil" android:backgroundTint="#FF8A00"
            android:textColor="#000000" android:layout_marginStart="5dp" />
    </LinearLayout>

    <Button android:id="@+id/btnTranslate" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ÇEVİR" android:backgroundTint="#B026FF" android:textColor="#FFFFFF"
        android:textStyle="bold" android:layout_marginTop="6dp" />

    <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:minHeight="110dp" android:padding="14dp"
        android:background="@drawable/card" android:textColor="#39FF14" android:textSize="20sp"
        android:textIsSelectable="true" android:text="Çeviri burada görünecek" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnSpeak" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🔊 Dinle" android:backgroundTint="#B026FF"
            android:textColor="#FFFFFF" android:layout_marginEnd="5dp" />
        <Button android:id="@+id/btnCopy" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📋 Kopyala" android:backgroundTint="#B026FF"
            android:textColor="#FFFFFF" android:layout_marginStart="5dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="GEÇMİŞ" android:textColor="#FF8A00" android:textStyle="bold" />
        <Button android:id="@+id/btnClear" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Temizle" android:backgroundTint="#1A1A22" android:textColor="#FF8A00" />
    </LinearLayout>
    <TextView android:id="@+id/tvHistory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#CCCCCC" android:textSize="14sp" android:lineSpacingExtra="6dp"
        android:textIsSelectable="true" android:paddingBottom="24dp" />
</LinearLayout>
</ScrollView>
